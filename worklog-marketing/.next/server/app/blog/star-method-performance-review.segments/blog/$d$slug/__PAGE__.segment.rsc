0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"bg-futuristic min-h-screen flex flex-col","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"The STAR Method for Performance Reviews: A Complete 2026 Guide\",\"description\":\"Learn the STAR method (Situation, Task, Action, Result) for self-appraisals with 15 real examples, common mistakes, and how to map STAR responses to company OKRs.\",\"mainEntityOfPage\":\"https://impactlyai.com/blog/star-method-performance-review\",\"url\":\"https://impactlyai.com/blog/star-method-performance-review\",\"image\":\"https://impactlyai.com/og-default.png\",\"author\":{\"@type\":\"Organization\",\"name\":\"Impactly AI Team\",\"url\":\"https://impactlyai.com\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Impactly AI\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://impactlyai.com/og-default.png\"}},\"datePublished\":\"2026-06-04\",\"dateModified\":\"2026-06-04\",\"keywords\":\"STAR method, performance review, self-appraisal, career growth\",\"articleSection\":\"TOFU\",\"wordCount\":471,\"timeRequired\":\"PT9M\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://impactlyai.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://impactlyai.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"The STAR Method for Performance Reviews: A Complete 2026 Guide\",\"item\":\"https://impactlyai.com/blog/star-method-performance-review\"}]}"}}],["$","header",null,{"className":"relative w-full z-50 border-b border-white/5 bg-black/10 backdrop-blur-md","children":["$","div",null,{"className":"max-w-7xl mx-auto px-6 py-4 flex justify-between items-center","children":[["$","$L2",null,{"href":"/","className":"flex items-center group","children":[["$","svg",null,{"className":"h-7 w-7 text-indigo-400","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2.5","children":["$","path",null,{"d":"M13 2L3 14h9l-1 8 10-12h-9l1-8z","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","span",null,{"className":"ml-2 text-lg font-bold text-white","children":"Impactly AI"}]]}],["$","$L2",null,{"href":"/blog","className":"inline-flex items-center gap-1.5 text-xs md:text-sm text-gray-400 hover:text-indigo-400 transition-colors font-medium","children":[["$","$L3",null,{"iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left w-4 h-4"}],["$","span",null,{"children":"Back to Blog"}]]}]]}]}],["$","main",null,{"className":"flex-1 max-w-3xl mx-auto px-6 py-16 w-full","children":[["$","article",null,{"children":[["$","header",null,{"className":"mb-10","children":[["$","div",null,{"className":"flex flex-wrap items-center gap-3 text-[10px] font-mono text-gray-500 uppercase tracking-widest mb-4","children":[["$","span",null,{"className":"px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-300 border border-indigo-500/20","children":"TOFU"}],[["$","span","STAR method",{"className":"px-2 py-0.5 rounded bg-white/5 border border-white/5 normal-case","children":"STAR method"}],["$","span","performance review",{"className":"px-2 py-0.5 rounded bg-white/5 border border-white/5 normal-case","children":"performance review"}]]]}],["$","h1",null,{"className":"text-3xl md:text-5xl font-extrabold text-white leading-tight mb-5","children":"The STAR Method for Performance Reviews: A Complete 2026 Guide"}],["$","p",null,{"className":"text-base md:text-lg text-gray-400 leading-relaxed mb-6","children":"If your self-appraisals read like a job description (\"managed team, delivered features\"), you are leaving promotion equity on the table. The STAR method is the proven structure for turning vague tasks into measurable impact."}],"$L4"]}],"$L5"]}],"$L6",false]}],"$L7"]}],["$L8"],"$L9"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"o0L4RACWWrua_LCfG0vVa"}
4:["$","div",null,{"className":"flex flex-wrap items-center gap-5 text-xs text-gray-500 border-t border-white/5 pt-5","children":[["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L3",null,{"iconNode":[["path",{"d":"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2","key":"975kel"}],["circle",{"cx":"12","cy":"7","r":"4","key":"17ys0d"}]],"className":"lucide-user w-3.5 h-3.5"}]," ","Impactly AI Team"]}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L3",null,{"iconNode":[["path",{"d":"M8 2v4","key":"1cmpym"}],["path",{"d":"M16 2v4","key":"4m81vk"}],["rect",{"width":"18","height":"18","x":"3","y":"4","rx":"2","key":"1hopcy"}],["path",{"d":"M3 10h18","key":"8toen8"}]],"className":"lucide-calendar w-3.5 h-3.5"}]," ","June 4, 2026"]}],["$","span",null,{"className":"flex items-center gap-1.5","children":[["$","$L3",null,{"iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"M12 6v6l4 2","key":"mmk7yg"}]],"className":"lucide-clock w-3.5 h-3.5"}]," ",9," min read"]}]]}]
5:["$","div",null,{"className":"prose-styles","children":[["$","p","0",{"className":"text-[15px] md:text-base text-gray-300 leading-[1.85] mb-5","children":"Self-appraisals fail the same way most resumes fail — they describe responsibilities instead of outcomes. The STAR method is a four-part structure that forces every accomplishment to land with a measurable result, which is exactly what calibration committees, hiring managers, and promotion packets need to see."}],["$","p","1",{"className":"text-[15px] md:text-base text-gray-300 leading-[1.85] mb-5","children":"STAR stands for Situation, Task, Action, Result. It came out of structured behavioral interviewing in the 1970s and has since become the default framework used by HR teams at companies like Google, Amazon, and Microsoft — both for evaluating candidates and for writing self-evaluations. The structure does two things at once: it forces specificity, and it makes your contribution easy to compare against peers."}],["$","h2","2",{"id":"why-star-works","className":"text-2xl md:text-3xl font-bold text-white mt-12 mb-4 scroll-mt-20","children":"Why STAR works for self-appraisals"}],["$","ul","3",{"className":"space-y-2 mb-6 pl-5 list-disc text-gray-300 text-[15px] leading-[1.85] marker:text-indigo-400","children":[["$","li","0",{"children":"Calibration committees read dozens of self-reviews per cycle — STAR responses are scannable in under 20 seconds."}],["$","li","1",{"children":"It separates your individual action from team outcomes, so credit lands with you instead of being smeared across a project."}],["$","li","2",{"children":"The required Result line forces a number, which anchors the rest of the appraisal in measurable impact."}],["$","li","3",{"children":"It maps cleanly to company OKRs, which is how most performance frameworks (Lattice, 15Five, Workday) score employees."}]]}],["$","h2","4",{"id":"the-four-components","className":"text-2xl md:text-3xl font-bold text-white mt-12 mb-4 scroll-mt-20","children":"The four STAR components, broken down"}],["$","h3","5",{"className":"text-xl md:text-2xl font-semibold text-white mt-8 mb-3 scroll-mt-20","children":"S — Situation: set the scene in one line"}],["$","p","6",{"className":"text-[15px] md:text-base text-gray-300 leading-[1.85] mb-5","children":"The Situation describes the business or technical context, not your job role. One sentence is enough. Skip backstory that does not directly inform the decision you made."}],["$","blockquote","7",{"className":"border-l-4 border-indigo-500/60 bg-indigo-500/5 pl-5 py-4 my-6 rounded-r-xl","children":[["$","p",null,{"className":"text-[15px] md:text-base text-gray-200 italic leading-relaxed","children":["“","Q4 dashboard load times had degraded from 1.2s to 4.8s after the analytics migration, and three enterprise accounts had cited it in renewal conversations.","”"]}],["$","footer",null,{"className":"mt-2 text-xs font-mono text-indigo-400/80 uppercase tracking-wider","children":["— ","Senior Engineer STAR example"]}]]}],["$","h3","8",{"className":"text-xl md:text-2xl font-semibold text-white mt-8 mb-3 scroll-mt-20","children":"T — Task: name the goal you owned"}],["$","p","9",{"className":"text-[15px] md:text-base text-gray-300 leading-[1.85] mb-5","children":"Be explicit about what you were responsible for. \"I was on the team that...\" is not a task — that is a project description. Use \"I was asked to,\" \"I committed to,\" or \"I took ownership of.\""}],["$","h3","10",{"className":"text-xl md:text-2xl font-semibold text-white mt-8 mb-3 scroll-mt-20","children":"A — Action: the verbs and decisions, in your voice"}],"$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]
6:["$","aside",null,{"className":"mt-16 pt-10 border-t border-white/5","children":[["$","h3",null,{"className":"text-sm font-mono text-gray-500 uppercase tracking-widest mb-5","children":"Role templates referenced"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-3 gap-4","children":[["$","$L2","software-engineer",{"href":"/templates/self-appraisal/software-engineer","className":"block p-4 glass rounded-xl border border-white/5 hover:border-white/15 transition-colors text-sm text-gray-300","children":["Software Engineer"," →"]}],["$","$L2","product-manager",{"href":"/templates/self-appraisal/product-manager","className":"block p-4 glass rounded-xl border border-white/5 hover:border-white/15 transition-colors text-sm text-gray-300","children":["Product Manager"," →"]}],["$","$L2","engineering-manager",{"href":"/templates/self-appraisal/engineering-manager","className":"block p-4 glass rounded-xl border border-white/5 hover:border-white/15 transition-colors text-sm text-gray-300","children":["Engineering Manager"," →"]}]]}]]}]
7:["$","footer",null,{"className":"border-t border-white/5 bg-black/40 py-10 px-6","children":["$","div",null,{"className":"max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-500","children":[["$","span",null,{"children":"© 2026 Impactly AI. All rights reserved."}],["$","div",null,{"className":"flex gap-6","children":[["$","$L2",null,{"href":"/","className":"hover:text-gray-300 transition-colors","children":"Home"}],["$","$L2",null,{"href":"/blog","className":"hover:text-gray-300 transition-colors","children":"Blog"}],["$","$L2",null,{"href":"/templates/self-appraisal","className":"hover:text-gray-300 transition-colors","children":"Templates"}],["$","$L2",null,{"href":"/privacy","className":"hover:text-gray-300 transition-colors","children":"Privacy"}],["$","$L2",null,{"href":"/terms","className":"hover:text-gray-300 transition-colors","children":"Terms"}],["$","a",null,{"href":"mailto:support@impactlyai.com","className":"hover:text-gray-300 transition-colors","children":"Contact"}]]}]]}]}]
